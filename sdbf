        Value = { Min = min, Max = max, Default = Config[key] },
        Callback = function(value)
            Config[key] = value
            if onChange then onChange(value) end
        end,
    })
    UI[key] = element
    return element
end

local function addDropdown(parent, key, title, desc, values, onChange)
    local element = parent:Dropdown({
        Title = title,
        Desc = desc,
        Flag = key,
        Values = values,
        Value = Config[key],
        Callback = function(selected)
            Config[key] = selected
            if onChange then onChange(selected) end
        end,
    })
    UI[key] = element
    return element
end

local function addHotkey(parent, flag, title, defaultKey, key)
    parent:Keybind({
        Title = title,
        Desc = "Click, then press a key. Works on PC. On mobile use the on-screen buttons.",
        Flag = flag,
        Value = defaultKey,
        Callback = function()
            toggleFeature(key)
        end,
    })
end

