-- Attack logic
local COMBAT = {
    Legit    = { fixedDelay = 0.2, multihit = 1 },
    Standard = { delayMul = 0.8,   multihit = 2 },
    Extreme  = { fixedDelay = 0,   multihit = 25 },
    Deadly   = { fixedDelay = 0,   multihit = 40 },
}

local function instaKillTarget(model, handle, tool, character)
    local now = os.clock()
    if now - (cooldowns[model] or 0) < Config.ReachInstaKillRate then return end
    cooldowns[model] = now

    local parts, seen = {}, {}
    local function add(part)
        if part and part:IsA("BasePart") and not seen[part] then
            seen[part] = true
            parts[#parts + 1] = part
        end
    end

    add(model:FindFirstChild("HumanoidRootPart"))
    add(model:FindFirstChild("UpperTorso"))
    add(model:FindFirstChild("Torso"))
    add(model:FindFirstChild("Head"))
    for _, child in ipairs(model:GetChildren()) do
        if #parts >= Config.ReachInstaKillParts then break end
        add(child)
    end

    for i = 1, math.min(#parts, Config.ReachInstaKillParts) do
        local part = parts[i]
        pcall(function()
            fireTouch(handle, part, 0)
            fireTouch(handle, part, 1)
        end)
    end

    pcall(function()
        if tool.Parent == character then tool:Activate() end
    end)
end

local function normalHit(model, targetRoot, handle)
    local profile = COMBAT[Config.ReachProfile] or COMBAT.Standard
    local delay = profile.fixedDelay or (Config.ReachHitDelay * (profile.delayMul or 1))
    local multihit = profile.multihit

    if Config.ReachAggressive then
        delay = 0
        multihit = multihit * 2
    end

    local now = os.clock()
    if now - (cooldowns[model] or 0) < delay then return end
    cooldowns[model] = now

    local bodyParts = {}
    if Config.ReachAggressive then
        for _, part in ipairs(model:GetChildren()) do
            if part:IsA("BasePart") then bodyParts[#bodyParts + 1] = part end
        end
    else
        bodyParts[1] = targetRoot
        local torso = model:FindFirstChild("UpperTorso") or model:FindFirstChild("Torso")
        if torso then bodyParts[#bodyParts + 1] = torso end
        if Config.ReachProfile == "Deadly" then
            local head = model:FindFirstChild("Head")
            if head then bodyParts[#bodyParts + 1] = head end
        end
    end

    for _ = 1, multihit do
        for _, part in ipairs(bodyParts) do
            pcall(function()
                fireTouch(handle, part, 0)
                fireTouch(handle, part, 1)
            end)
        end
    end
end

local function performReach()
    if not Config.ReachEnabled or not fireTouch or Shared.parryBusy then return end

    local character = lp.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    local tool = character and character:FindFirstChildOfClass("Tool")
    local handle = tool and (tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart"))
    if not (root and handle) then return end

    if Config.ReachExpandWeapon then
        if not originalHandle[handle] then
            originalHandle[handle] = {
                size = handle.Size,
                transparency = handle.Transparency,
                massless = handle.Massless,
                canCollide = handle.CanCollide,
            }
        end
        local d = math.min(Config.ReachDistance, 2048)
        handle.Size = Vector3.new(d, d, d)
        handle.Massless = true
        handle.CanCollide = false
        handle.Transparency = 1
    elseif originalHandle[handle] then
        restoreHandle(handle)
    end

    -- "Swinging" = a recent activation, or the button is held (manual play only)
    local swinging = (os.clock() - Shared.lastActivated < 0.35) or (isSwinging and not Config.AutoClick)
    if not (swinging or Config.ReachAlwaysActive or Config.ReachInstaKill) then return end

    local ping = getPing()
    local origin = root.Position
    local rootCF = root.CFrame
    local processed = 0

    local candidates = {}
    local prefilter = Config.ReachDistance * 2 + Config.ReachRandomStrength + 10
    for _, model in ipairs(getNPCs()) do
        local targetRoot = model:FindFirstChild("HumanoidRootPart")
        if targetRoot then
            local dist = (origin - targetRoot.Position).Magnitude
            if dist <= prefilter then
                candidates[#candidates + 1] = { model = model, root = targetRoot, dist = dist }
            end
        end
    end

    if #candidates > 1 then
        table.sort(candidates, function(a, b) return a.dist < b.dist end)
    end

    for _, c in ipairs(candidates) do
        if processed >= Config.PerfMaxTargets then break end

        local model, targetRoot = c.model, c.root
        local humanoid = getHumanoid(model)

        if humanoid and humanoid.Health > 0 then
            local targetPos = targetRoot.Position
            if Config.ReachPredictive and not Config.ReachAggressive then
                targetPos = targetPos + targetRoot.AssemblyLinearVelocity * (ping / 1000)
            end

            local hit = inReachHitbox(origin, targetPos, rootCF)

            if not hit and Config.ReachBacktrack then
                local buffer = backtrackBuffers[model]
                if buffer then
                    for i = #buffer, 1, -1 do
                        if inReachHitbox(origin, buffer[i].pos, rootCF) then
                            targetPos = buffer[i].pos
                            hit = true
                            break
                        end
                    end
                end
            end

            if hit and Config.ReachWallCheck and not Config.ReachAggressive
                and isWallBetween(origin, targetPos, model) then
                hit = false
            end

            if hit then
                processed = processed + 1
                if Config.ReachInstaKill then
                    instaKillTarget(model, handle, tool, character)
                else
                    normalHit(model, targetRoot, handle)
                end
            end
        end
    end
end

bind(RunService.Heartbeat, performReach)

