local npcSet = setmetatable({}, { __mode = "k" })
local npcList = {}
local npcListDirty = true
local npcListBuiltAt = 0

local function isPlayerCharacter(model)
    return model == lp.Character or Players:GetPlayerFromCharacter(model) ~= nil
end

local function registerHumanoid(humanoid)
    local model = humanoid.Parent
    if model and model:IsA("Model") then
        npcSet[model] = true
        npcListDirty = true
    end
end

local function scanNPCs()
    local counter = 0
    for _, descendant in ipairs(Workspace:GetDescendants()) do
        if descendant:IsA("Humanoid") then
            registerHumanoid(descendant)
        end
        counter = counter + 1
        if counter % 400 == 0 then
            task.wait()
            if not running then return end
        end
    end
end

bind(Workspace.DescendantAdded, function(descendant)
    if descendant:IsA("Humanoid") then
        registerHumanoid(descendant)
    end
end)

bind(Workspace.DescendantRemoving, function(descendant)
    if descendant:IsA("Humanoid") then
        local model = descendant.Parent
        if model and npcSet[model] then
            npcSet[model] = nil
            npcListDirty = true
        end
    end
end)

task.spawn(scanNPCs)

-- NPC models only (players are always excluded). Rebuilt at most once per second.
local function getNPCs()
    local now = os.clock()
    if npcListDirty and now - npcListBuiltAt > 1 then
        npcListBuiltAt = now
        npcListDirty = false
        npcList = {}
        for model in pairs(npcSet) do
            if model.Parent and not isPlayerCharacter(model) then
                npcList[#npcList + 1] = model
            end
        end
    end
    return npcList
end

