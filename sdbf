-- Tool / swing tracking
local isSwinging = false
local originalHandle = setmetatable({}, { __mode = "k" })
local cooldowns = setmetatable({}, { __mode = "k" })

local function restoreHandle(handle)
    local saved = originalHandle[handle]
    if saved and handle.Parent then
        handle.Size = saved.size
        handle.Transparency = saved.transparency
        handle.Massless = saved.massless
        handle.CanCollide = saved.canCollide
    end
    originalHandle[handle] = nil
end

