-- ===================== BOSS LOCK / ORBIT ===========================
----------------------------------------------------------------------
local bossTarget
local orbitAngle = 0
local setTargetLabel

local function scanForBoss(container, origin, best, bestDistance, depth)
    for _, object in ipairs(container:GetChildren()) do
        if object:IsA("Model") then
            local humanoid = object:FindFirstChildOfClass("Humanoid")
            if humanoid then
                if object ~= lp.Character and humanoid.Health > 0
                    and not Players:GetPlayerFromCharacter(object) then
                    local root = getRoot(object)
                    if root then
                        local distance = (root.Position - origin).Magnitude
                        if distance < bestDistance then
                            best, bestDistance = object, distance
                        end
                    end
                end
            elseif depth < 4 then
                best, bestDistance = scanForBoss(object, origin, best, bestDistance, depth + 1)
            end
        elseif object:IsA("Folder") and depth < 4 then
            best, bestDistance = scanForBoss(object, origin, best, bestDistance, depth + 1)
        end
    end
    return best, bestDistance
end

task.spawn(function()
    while running do
        task.wait(0.3)

        if Config.BossLock or Config.BossOrbit then
            local character = lp.Character
            local root = character and getRoot(character)
            if root then
                bossTarget = scanForBoss(Workspace, root.Position, nil, 500, 0)
            end
            if setTargetLabel then
                setTargetLabel(bossTarget and ("Target: " .. bossTarget.Name) or "Target: none within 500 studs")
            end
        else
            bossTarget = nil
            if setTargetLabel then
                setTargetLabel("Target: idle (Boss Lock and Orbit are off)")
            end
        end
    end
end)

bind(RunService.RenderStepped, function(delta)
    if not (Config.BossLock or Config.BossOrbit) or not bossTarget then return end

    local character = lp.Character
    local root = character and getRoot(character)
    local targetRoot = getRoot(bossTarget)
    if not (root and targetRoot) then return end

    local targetPosition = targetRoot.Position

    if Config.BossOrbit then
        orbitAngle = (orbitAngle + Config.OrbitSpeed * 0.2 * delta * 30) % (math.pi * 2)

        -- With Floating Ground on, keep our current height so we stay on the platform
        local y = (Config.FloatEnabled and Shared.platformLocked) and root.Position.Y or targetPosition.Y

        local position = Vector3.new(
            targetPosition.X + math.cos(orbitAngle) * Config.OrbitDistance,
            y,
            targetPosition.Z + math.sin(orbitAngle) * Config.OrbitDistance
        )
        local goal = CFrame.new(position, Vector3.new(targetPosition.X, position.Y, targetPosition.Z))
        local alpha = math.clamp(Config.OrbitSpeed / 200 * 1.5, 0.2, 1)
        root.CFrame = root.CFrame:Lerp(goal, alpha)
    elseif Config.BossLock then
        local goal = CFrame.new(root.Position, Vector3.new(targetPosition.X, root.Position.Y, targetPosition.Z))
        root.CFrame = root.CFrame:Lerp(goal, 0.4)
    end
end)

