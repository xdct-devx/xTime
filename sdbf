-- ===================== NPC REACH ===================================
----------------------------------------------------------------------
local fireTouch = firetouchinterest

-- Visualizer
local visualizerPart
local sectorParts = {}

local function destroyVisualizer()
    if visualizerPart then
        visualizerPart:Destroy()
        visualizerPart = nil
    end
    for _, part in ipairs(sectorParts) do part:Destroy() end
    table.clear(sectorParts)
end

onCleanup(destroyVisualizer)

local function newVisualPart()
    local part = Instance.new("Part")
    part.Material = Enum.Material.ForceField
    part.CanCollide = false
    part.CanQuery = false
    part.CanTouch = false
    part.CastShadow = false
    part.Anchored = true
    part.Archivable = false
    return part
end

local SECTOR_SPOKES, SECTOR_ARC = 24, 14
local SECTOR_HALF_ANGLE = math.rad(50)

local function updateVisualizer()
    if not (Config.ReachEnabled and Config.ReachShowVisualizer) then
        if visualizerPart or #sectorParts > 0 then destroyVisualizer() end
        return
    end

    local character = lp.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local parent = Workspace.CurrentCamera or Workspace
    local reach = Config.ReachDistance
    local drawReach = math.min(reach, 1000) -- Roblox parts are limited to 2048 studs per side
    local transparency = Config.ReachVisualizerTransparency
    local danger = Config.ReachAggressive or Config.ReachInstaKill or Config.ReachTouchKill
    local color = danger and Color3.fromRGB(248, 113, 113) or Color3.fromRGB(56, 189, 248)

    if Config.ReachShape == "Sector" and not Config.ReachAggressive then
        if visualizerPart then
            visualizerPart:Destroy()
            visualizerPart = nil
        end

        local total = SECTOR_SPOKES + SECTOR_ARC
        while #sectorParts < total do
            sectorParts[#sectorParts + 1] = newVisualPart()
        end

        local step = (2 * SECTOR_HALF_ANGLE) / math.max(SECTOR_SPOKES - 1, 1)
        local width = math.max(1, drawReach * step * 1.25)

        for i = 1, SECTOR_SPOKES do
            local part = sectorParts[i]
            local angle = -SECTOR_HALF_ANGLE + (i - 1) / (SECTOR_SPOKES - 1) * (2 * SECTOR_HALF_ANGLE)
            part.Color = color
            part.Transparency = transparency
            part.Size = Vector3.new(width, 3.5, drawReach)
            part.CFrame = (root.CFrame * CFrame.Angles(0, angle, 0)) * CFrame.new(0, 0, -drawReach / 2)
            part.Parent = parent
        end

        for j = 1, SECTOR_ARC do
            local part = sectorParts[SECTOR_SPOKES + j]
            local angle = -SECTOR_HALF_ANGLE + (j - 1) / (SECTOR_ARC - 1) * (2 * SECTOR_HALF_ANGLE)
            part.Color = color
            part.Transparency = transparency
            part.Size = Vector3.new(width, 3.5, width)
            part.CFrame = root.CFrame * CFrame.new(math.sin(angle) * drawReach, 0, -math.cos(angle) * drawReach)
            part.Parent = parent
        end
        return
    end

    if #sectorParts > 0 then
        for _, part in ipairs(sectorParts) do part:Destroy() end
        table.clear(sectorParts)
    end

    if not visualizerPart or not visualizerPart.Parent then
        if visualizerPart then visualizerPart:Destroy() end
        visualizerPart = newVisualPart()
        visualizerPart.Name = "xTimeReachVisualizer"
    end

    visualizerPart.Parent = parent
    visualizerPart.Color = color
    visualizerPart.Transparency = transparency

    local shape = Config.ReachAggressive and "Sphere" or Config.ReachShape
    if shape == "Sphere" then
        visualizerPart.Shape = Enum.PartType.Ball
        visualizerPart.Size = Vector3.new(drawReach * 2, drawReach * 2, drawReach * 2)
        visualizerPart.CFrame = root.CFrame
    elseif shape == "Square" then
        visualizerPart.Shape = Enum.PartType.Block
        visualizerPart.Size = Vector3.new(drawReach * 2, drawReach * 2, drawReach * 2)
        visualizerPart.CFrame = root.CFrame
    else -- Line
        visualizerPart.Shape = Enum.PartType.Block
        visualizerPart.Size = Vector3.new(4, 7, drawReach)
        visualizerPart.CFrame = root.CFrame * CFrame.new(0, 0, -drawReach / 2)
    end
end

