----------------------------------------------------------------------
-- ===================== AUTO PARRY ==================================
----------------------------------------------------------------------
local TRIGGER_ID = "214269134"
local TOOL_IVORY = "Ivory Periastron"
local TOOL_AZURE = "Azure Periastron"
local TORSO_NAMES = { Torso = true, UpperTorso = true }

local telemetry = { parries = 0, latency = nil, ping = 0 }
local refreshStatus

local function findTool(name)
    local character = lp.Character
    local backpack = lp:FindFirstChildOfClass("Backpack")
    return (character and character:FindFirstChild(name)) or (backpack and backpack:FindFirstChild(name))
end

local function equip(name)
    local humanoid = getHumanoid(lp.Character)
    local tool = findTool(name)
    if humanoid and tool and tool.Parent ~= lp.Character then
        humanoid:EquipTool(tool)
    end
    return tool
end

local function waitEquipped(tool, timeout)
    local character = lp.Character
    local startedAt = os.clock()
    while running and tool.Parent ~= character and os.clock() - startedAt < (timeout or 0.3) do
        RunService.Heartbeat:Wait()
    end
    return tool.Parent == character
end

local function fireE(tool)
    local remote = tool and tool:FindFirstChild("Remote")
    if remote then
        remote:FireServer(Enum.KeyCode.E)
        return true
    end
    return false
end

local function settle()
    if Config.Settle > 0 then
        task.wait(Config.Settle / 1000)
    end
end

local parryBusy = false
local lastTrigger = 0

local function computeDelay()
    local ms
    if Config.Humanize then
        local low = math.min(Config.HumanizeMin, Config.HumanizeMax)
        local high = math.max(Config.HumanizeMin, Config.HumanizeMax)
        ms = math.random(low, high)
    else
        ms = Config.Delay
    end
    if Config.PingComp then
        ms = ms - telemetry.ping
    end
    return math.max(ms, 0) / 1000
end

local function runParry(detectedAt)
    local humanoid = getHumanoid(lp.Character)
    if not humanoid or humanoid.Health <= 0 then return end

    local firedAt

    if Config.ParryMode == "Ivory > Azure" then
        local ivory = equip(TOOL_IVORY)
        if ivory and waitEquipped(ivory) then
            settle()
            fireE(ivory)
            firedAt = firedAt or os.clock()
            task.wait(0.01)
            fireE(ivory)
        end
    else
        humanoid:UnequipTools()
        RunService.Heartbeat:Wait()
    end

    local azure = equip(TOOL_AZURE)
    if azure and waitEquipped(azure) then
        settle()
        fireE(azure)
        firedAt = firedAt or os.clock()
    end

    if firedAt then
        telemetry.parries = telemetry.parries + 1
        telemetry.latency = (firedAt - detectedAt) * 1000
        if refreshStatus then refreshStatus() end
    end
end

local function triggerParry()
    local now = os.clock()
    if parryBusy or now - lastTrigger < Config.Cooldown / 1000 then return end

    parryBusy = true
    Shared.parryBusy = true
    lastTrigger = now
    telemetry.ping = getPing()

    task.spawn(function()
        local delay = computeDelay()
        if delay > 0 then task.wait(delay) end

        local ok, err = pcall(runParry, now)
        if not ok then
            warn("[xTime] parry error: " .. tostring(err))
        end

        parryBusy = false
        Shared.parryBusy = false
    end)
end

local function matchesTrigger(instance)
    local id
    if instance:IsA("ParticleEmitter") then
        id = instance.Texture
    elseif instance:IsA("MeshPart") or instance:IsA("SpecialMesh") then
        id = instance.MeshId
    end
    return id ~= nil and string.match(id, "%d+") == TRIGGER_ID
end

local function onDescendantAdded(instance)
    if not Config.AutoParry then return end

    local character = lp.Character
    local parent = instance.Parent
    if not character or not parent or parent.Name ~= "IFrame" then return end

    local torso = parent.Parent
    if not (torso and TORSO_NAMES[torso.Name] and torso.Parent == character) then return end

    if not (instance:IsA("ParticleEmitter") or instance:IsA("MeshPart") or instance:IsA("SpecialMesh")) then
        return
    end

    if matchesTrigger(instance) then
        triggerParry()
    else
        task.defer(function()
            if running and instance.Parent and matchesTrigger(instance) then
                triggerParry()
            end
        end)
    end
end

local characterConnections = {}

local function hookParryCharacter(character)
    for _, connection in ipairs(characterConnections) do
        connection:Disconnect()
    end
    table.clear(characterConnections)

    characterConnections[1] = character.DescendantAdded:Connect(onDescendantAdded)
    characterConnections[2] = character.ChildAdded:Connect(function(child)
        if Config.AutoParry and Config.AzureAutoE and not parryBusy
            and child:IsA("Tool") and child.Name == TOOL_AZURE then
            task.delay(Config.Settle / 1000, fireE, child)
        end
    end)
end

onCleanup(function()
    for _, connection in ipairs(characterConnections) do
        connection:Disconnect()
    end
end)

bind(lp.CharacterAdded, hookParryCharacter)
if lp.Character then hookParryCharacter(lp.Character) end

