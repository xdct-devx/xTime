-- ===================== FLOATING GROUND =============================
----------------------------------------------------------------------
local CAP_SIZE = 6
local CAP_THICKNESS = 1
local POLE_SIZE = 2
local FALL_PROTECTION = 8

local floatCharacter, floatHumanoid, floatHrp
local capPart, polePart
local floatBaseY = 0
local floatGroundY = 0
local floatDiedConn
local floatHeartbeat

local function destroyFloatParts()
    if capPart then capPart:Destroy() capPart = nil end
    if polePart then polePart:Destroy() polePart = nil end
end

local function createFloatParts()
    destroyFloatParts()

    local cap = Instance.new("Part")
    cap.Name = "xTimeFloatCap_" .. lp.Name
    cap.Size = Vector3.new(CAP_SIZE, CAP_THICKNESS, CAP_SIZE)
    cap.Anchored = true
    cap.CanCollide = true
    cap.CanTouch = false
    cap.CanQuery = false
    cap.Material = Enum.Material.ForceField
    cap.Color = Color3.fromRGB(56, 189, 248)
    cap.Transparency = 0.25
    cap.TopSurface = Enum.SurfaceType.Smooth
    cap.BottomSurface = Enum.SurfaceType.Smooth
    cap.Parent = Workspace
    capPart = cap

    local pole = Instance.new("Part")
    pole.Name = "xTimeFloatPole_" .. lp.Name
    pole.Size = Vector3.new(POLE_SIZE, 1, POLE_SIZE)
    pole.Anchored = true
    pole.CanCollide = false
    pole.CanTouch = false
    pole.CanQuery = false
    pole.Material = Enum.Material.ForceField
    pole.Color = Color3.fromRGB(56, 189, 248)
    pole.Transparency = 0.6
    pole.Parent = Workspace
    polePart = pole
end

local function getGroundY()
    if not floatHrp or not floatHrp.Parent then return nil end

    local filter = {}
    if capPart then filter[#filter + 1] = capPart end
    if polePart then filter[#filter + 1] = polePart end
    if floatCharacter then filter[#filter + 1] = floatCharacter end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filter
    params.IgnoreWater = true

    local result = Workspace:Raycast(floatHrp.Position, Vector3.new(0, -1000, 0), params)
    return result and result.Position.Y or nil
end

local function placeOnPlatform(force)
    if not Config.FloatEnabled or not Shared.platformLocked or not Shared.platformY then return end
    if not floatHrp or not floatHrp.Parent or not floatHumanoid or floatHumanoid.Health <= 0 or not capPart then
        return
    end

    local safeY = Shared.platformY + CAP_THICKNESS / 2 + 2.5
    if force or floatHrp.Position.Y < safeY - FALL_PROTECTION then
        floatHrp.CFrame = CFrame.new(floatHrp.Position.X, safeY, floatHrp.Position.Z)
        floatHrp.AssemblyLinearVelocity = Vector3.zero
        floatHrp.AssemblyAngularVelocity = Vector3.zero
    end
end

local function lockPlatformFromCurrent()
    if not floatHrp or not floatHrp.Parent then return end

    local ground = getGroundY() or (floatHrp.Position.Y - 3)
    floatGroundY = ground
    floatBaseY = ground
    Shared.platformY = floatBaseY + Config.FloatHeight
    Shared.platformLocked = true
end

local function updatePlatform()
    if not capPart or not polePart then return end

    if not Config.FloatEnabled or not Shared.platformLocked or not Shared.platformY then
        capPart.CanCollide = false
        capPart.Transparency = 1
        polePart.Transparency = 1
        return
    end

    if not floatCharacter or not floatCharacter.Parent or not floatHumanoid
        or floatHumanoid.Health <= 0 or not floatHrp or not floatHrp.Parent then
        return
    end

    capPart.CanCollide = true
    capPart.Transparency = 0.25
    polePart.Transparency = 0.6

    local x, z = floatHrp.Position.X, floatHrp.Position.Z
    capPart.CFrame = CFrame.new(x, Shared.platformY - CAP_THICKNESS / 2, z)

    local poleHeight = math.max(Shared.platformY - floatGroundY, 0.1)
    polePart.Size = Vector3.new(POLE_SIZE, poleHeight, POLE_SIZE)
    polePart.CFrame = CFrame.new(x, floatGroundY + poleHeight / 2, z)

    placeOnPlatform(false)
end

local function onFloatCharacter(char)
    if floatHeartbeat then floatHeartbeat:Disconnect() floatHeartbeat = nil end
    if floatDiedConn then floatDiedConn:Disconnect() floatDiedConn = nil end

    floatCharacter = char
    floatHumanoid = char:WaitForChild("Humanoid", 10)
    floatHrp = char:WaitForChild("HumanoidRootPart", 10)
    if not (floatHumanoid and floatHrp) or not running then return end

    createFloatParts()
    task.wait(0.15)

    if Config.FloatEnabled then
        lockPlatformFromCurrent()
        placeOnPlatform(true)
    else
        Shared.platformLocked = false
    end

    floatDiedConn = floatHumanoid.Died:Connect(function()
        Shared.platformLocked = false
        if floatHeartbeat then floatHeartbeat:Disconnect() floatHeartbeat = nil end
        task.delay(0.5, destroyFloatParts)
    end)

    floatHeartbeat = RunService.Heartbeat:Connect(updatePlatform)
end

bind(lp.CharacterAdded, onFloatCharacter)
bind(lp.CharacterRemoving, function()
    if floatHeartbeat then floatHeartbeat:Disconnect() floatHeartbeat = nil end
    if floatDiedConn then floatDiedConn:Disconnect() floatDiedConn = nil end
    destroyFloatParts()
    Shared.platformLocked = false
    Shared.platformY = nil
    floatCharacter, floatHumanoid, floatHrp = nil, nil, nil
end)

onCleanup(function()
    if floatHeartbeat then floatHeartbeat:Disconnect() end
    if floatDiedConn then floatDiedConn:Disconnect() end
    destroyFloatParts()
    Shared.platformLocked = false
end)

if lp.Character then task.spawn(onFloatCharacter, lp.Character) end

local function setFloatEnabled(on)
    Config.FloatEnabled = on
    if on then
        lockPlatformFromCurrent()
        task.defer(placeOnPlatform, true)
    else
        Shared.platformLocked = false
    end
end

local function setFloatHeight(value)
    Config.FloatHeight = value
    if Config.FloatEnabled and Shared.platformLocked then
        Shared.platformY = floatBaseY + value
        placeOnPlatform(true)
    end
end

