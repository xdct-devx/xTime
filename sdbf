local originalText = setmetatable({}, { __mode = "k" })

local function plainReplace(text, find, replacement)
    if find == "" then return text end
    local parts, index = {}, 1
    while true do
        local from, to = string.find(text, find, index, true)
        if not from then
            parts[#parts + 1] = string.sub(text, index)
            break
        end
        parts[#parts + 1] = string.sub(text, index, from - 1)
        parts[#parts + 1] = replacement
        index = to + 1
    end
    return table.concat(parts)
end

local function applyIdentityTo(object)
    local current = object.Text
    if current == "" then return end

    local newName = Config.Identity
    local updated = plainReplace(current, "@" .. lp.Name, "@" .. string.lower(newName))
    updated = plainReplace(updated, lp.DisplayName, newName)
    updated = plainReplace(updated, lp.Name, newName)

    if updated ~= current then
        originalText[object] = originalText[object] or current
        object.Text = updated
    end
end

local function isOwnGui(object)
    if object:FindFirstAncestor("xTimeESP") or object:FindFirstAncestor("xTimeButtons") then
        return true
    end
    local screenGui = object:FindFirstAncestorWhichIsA("ScreenGui")
    return screenGui ~= nil and screenGui.Name == "WindUI"
end

local function forEachTextObject(callback)
    local function walk(root)
        for _, object in ipairs(root:GetDescendants()) do
            if (object:IsA("TextLabel") or object:IsA("TextButton")) and not isOwnGui(object) then
                callback(object)
            end
        end
    end
    pcall(walk, CoreGui)
    pcall(walk, playerGui)
end

task.spawn(function()
    while running do
        if Config.IdentityApplied then
            forEachTextObject(applyIdentityTo)
        end
        task.wait(1)
    end
end)

local function restoreIdentity()
    Config.IdentityApplied = false
    for object, text in pairs(originalText) do
        if object.Parent then object.Text = text end
    end
    table.clear(originalText)
end

