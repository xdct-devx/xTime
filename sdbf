-- Hitbox math
local function isWallBetween(from, to, ignoreModel)
    local filter = {}
    if lp.Character then filter[#filter + 1] = lp.Character end
    if ignoreModel then filter[#filter + 1] = ignoreModel end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = filter

    local result = Workspace:Raycast(from, to - from, params)
    if result then
        local hit = result.Instance
        return hit.CanCollide and hit.Anchored
    end
    return false
end

local function inReachHitbox(origin, targetPos, rootCF)
    local reach = Config.ReachDistance
    if Config.ReachRandom then
        reach = reach + (math.random(-100, 100) / 100) * Config.ReachRandomStrength
    end

    local toTarget = targetPos - origin
    local dist = toTarget.Magnitude

    if Config.ReachAggressive then
        return dist <= reach
    end

    local relPos = rootCF:PointToObjectSpace(targetPos)
    local flatFwd = Vector3.new(rootCF.LookVector.X, 0, rootCF.LookVector.Z)
    local flatDir = Vector3.new(toTarget.X, 0, toTarget.Z)
    local dot = 1
    if flatFwd.Magnitude > 0.001 and flatDir.Magnitude > 0.001 then
        dot = flatFwd.Unit:Dot(flatDir.Unit)
    end

    local legit = Config.ReachProfile == "Legit"
    if legit and dot < 0.707 then return false end

    local shape = Config.ReachShape
    if shape == "Sphere" then
        return dist <= reach
    elseif shape == "Square" then
        return math.abs(relPos.X) <= reach and math.abs(relPos.Y) <= reach and math.abs(relPos.Z) <= reach
    elseif shape == "Line" then
        local inLane = math.abs(relPos.X) <= 2 and math.abs(relPos.Y) <= 3.5
        if legit then
            return inLane and relPos.Z <= 0 and relPos.Z >= -reach
        end
        return inLane and math.abs(relPos.Z) <= reach
    elseif shape == "Sector" then
        return dist <= reach and math.abs(relPos.Y) <= 3.5 and dot >= 0.6428
    end
    return false
end

-- Backtrack (newest entry last)
local backtrackBuffers = setmetatable({}, { __mode = "k" })

local function recordBacktrack(model, rootPart, now)
    local buffer = backtrackBuffers[model]
    if not buffer then
        buffer = {}
        backtrackBuffers[model] = buffer
    end

    buffer[#buffer + 1] = { pos = rootPart.Position, t = now }

    local window = Config.ReachBacktrackWindow
    while buffer[1] and now - buffer[1].t > window do
        table.remove(buffer, 1)
    end
end

bind(RunService.Heartbeat, function()
    if not (Config.ReachEnabled and Config.ReachBacktrack) then return end

    local character = lp.Character
    local myRoot = character and character:FindFirstChild("HumanoidRootPart")
    if not myRoot then return end

    local now = os.clock()
    local maxRange = Config.ReachDistance * 2 + 20

    for _, model in ipairs(getNPCs()) do
        local rootPart = model:FindFirstChild("HumanoidRootPart")
        if rootPart and (rootPart.Position - myRoot.Position).Magnitude <= maxRange then
            recordBacktrack(model, rootPart, now)
        end
    end
end)

-- Touch kill
local killCooldowns = setmetatable({}, { __mode = "k" })
local remoteCooldowns = setmetatable({}, { __mode = "k" })

local function killNPCTouch(model, part)
    if not model or not model.Parent then return end

    local now = os.clock()
    if now - (killCooldowns[model] or 0) < Config.PerfKillThrottle then return end
    killCooldowns[model] = now

    local humanoid = getHumanoid(model)

    if humanoid and humanoid.Health > 0 then
        pcall(function()
            humanoid.Health = 0
            humanoid:TakeDamage(999999999)
        end)
        if humanoid.Health <= 0 then return end
    end

    if now - (remoteCooldowns[model] or 0) >= Config.PerfRemoteCooldown then
        remoteCooldowns[model] = now
        pcall(function()
            for _, object in ipairs(model:GetDescendants()) do
                if object:IsA("RemoteEvent") then
                    local name = object.Name:lower()
                    if name:find("damage") or name:find("hit") or name:find("attack") then
                        object:FireServer(part, 999999999)
                    end
                end
            end
        end)
    end

    humanoid = getHumanoid(model)
    if humanoid and humanoid.Health > 0 then
        pcall(function()
            for _, object in ipairs(model:GetDescendants()) do
                if object:IsA("BasePart") then object:BreakJoints() end
            end
        end)

        local tool = lp.Character and lp.Character:FindFirstChildOfClass("Tool")
        local handle = tool and (tool:FindFirstChild("Handle") or tool:FindFirstChildWhichIsA("BasePart"))
        if handle and fireTouch then
            pcall(function()
                for _, object in ipairs(model:GetChildren()) do
                    if object:IsA("BasePart") then
                        fireTouch(handle, object, 0)
                        fireTouch(handle, object, 1)
                    end
                end
            end)
        end
    end
end

local hookedHandles = setmetatable({}, { __mode = "k" })

local function hookTouchPart(part)
    if not part:IsA("BasePart") or hookedHandles[part] then return end
    hookedHandles[part] = true

    bind(part.Touched, function(hit)
        if not (Config.ReachTouchKill and Config.ReachEnabled) then return end

        local model = hit:FindFirstAncestorOfClass("Model")
        if not model or not npcSet[model] or isPlayerCharacter(model) then return end

        local character = lp.Character
        local root = character and character:FindFirstChild("HumanoidRootPart")
        local npcRoot = getRoot(model)
        if not (root and npcRoot) then return end

        if (root.Position - npcRoot.Position).Magnitude <= Config.ReachTouchRange + Config.ReachDistance then
            killNPCTouch(model, hit)
        end
    end)
end

local function hookTouchTool(tool)
    if not tool:IsA("Tool") then return end
    local handle = tool:FindFirstChild("Handle")
    if handle then hookTouchPart(handle) end
    bind(tool.ChildAdded, function(child)
        if child.Name == "Handle" then hookTouchPart(child) end
    end)
end

